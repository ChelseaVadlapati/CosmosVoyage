{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run FastAPI Server",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "uvicorn",
                "fastapi_app:app",
                "--reload",
                "--port=8000"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "showReuseMessage": false
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "isBackground": true,
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Stop FastAPI Server",
            "type": "shell",
            "command": "echo 'Stopping server...' && kill $(lsof -ti:8000) 2>/dev/null || echo 'No server running on port 8000'",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
